#!/usr/bin/env python3
"""Expose installed native plugin skills to Shelley without changing their files."""

import argparse
import json
import os
import re
import selectors
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import xml.etree.ElementTree as ET
from pathlib import Path


def discover() -> list[dict]:
    """Ask Codex's local app server for skill metadata without starting a model turn."""
    executable = shutil.which("codex") or str(Path.home() / ".local/bin/codex")
    with subprocess.Popen(
        [executable, "app-server", "--stdio"], cwd=Path.home(),
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    ) as process, selectors.DefaultSelector() as selector:
        selector.register(process.stdout, selectors.EVENT_READ)
        buffered = bytearray()

        def send(message: dict) -> None:
            process.stdin.write(json.dumps(message).encode() + b"\n")
            process.stdin.flush()

        def request(identifier: int, method: str, params: dict) -> dict:
            send({"id": identifier, "method": method, "params": params})
            deadline = time.monotonic() + 20
            while True:
                while (newline := buffered.find(b"\n")) >= 0:
                    response = json.loads(buffered[:newline])
                    del buffered[:newline + 1]
                    if response.get("id") == identifier:
                        if "error" in response:
                            raise RuntimeError(f"Codex {method}: {response['error']}")
                        return response["result"]
                remaining = deadline - time.monotonic()
                if remaining <= 0 or not selector.select(remaining):
                    raise TimeoutError(f"Codex {method} timed out")
                chunk = os.read(process.stdout.fileno(), 65536)
                if not chunk:
                    raise RuntimeError("Codex closed the discovery stream")
                buffered.extend(chunk)

        try:
            request(1, "initialize", {
                "clientInfo": {"name": "shelley-plugin-skills", "version": "1"},
                "capabilities": {"experimentalApi": True},
            })
            send({"method": "initialized"})
            result = request(2, "skills/list", {
                "cwds": [str(Path.home())], "forceReload": True,
            })["data"][0]
            if result["errors"]:
                raise RuntimeError(f"Codex skill discovery errors: {result['errors']}")
            return result["skills"]
        finally:
            process.terminate()
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


def catalog_entries(skills: list[dict], plugins: set[str]) -> list[dict]:
    """Keep enabled skills from the selected plugins and retain their native names."""
    entries = {}
    for skill in skills:
        if not skill["enabled"] or skill.get("pluginId") not in plugins:
            continue
        name = skill["name"]
        if name in entries:
            raise ValueError(f"Duplicate plugin skill: {name}")
        path = Path(skill["path"])
        if not path.is_absolute():
            raise ValueError(f"Skill path must be absolute: {path}")
        header = path.read_text().split("\n---", 1)[0]
        explicit = bool(re.search(
            r"^disable-model-invocation:\s*(?:true|yes|on)\s*(?:#.*)?$", header, re.M,
        ))
        entries[name] = {
            "name": name, "description": skill["description"], "path": str(path),
            "explicit": explicit, "plugin": skill["pluginId"],
        }
    return [entries[name] for name in sorted(entries)]


def refresh(home: Path) -> int:
    """Atomically cache discovery metadata after native plugin installation."""
    config = json.loads((home / ".config/shelley/plugin-sources.json").read_text())
    entries = catalog_entries(discover(), set(config["plugins"]))
    cache = home / ".cache/shelley/plugin-skills.json"
    content = json.dumps({"version": 1, "skills": entries}, indent=2) + "\n"
    if cache.exists() and cache.read_text() == content:
        return len(entries)
    cache.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=cache.parent, delete=False) as temporary:
        temporary.write(content)
    temporary_path = Path(temporary.name)
    try:
        temporary_path.replace(cache)
    finally:
        temporary_path.unlink(missing_ok=True)
    return len(entries)


def load_catalog(home: Path) -> list[dict]:
    """Read the cached index, omitting files removed since the last refresh."""
    data = json.loads((home / ".cache/shelley/plugin-skills.json").read_text())
    if data.get("version") != 1 or not isinstance(data.get("skills"), list):
        raise ValueError("Unsupported plugin skill catalog; run plugin-skills refresh")
    return [entry for entry in data["skills"] if Path(entry["path"]).is_file()]


def prompt_catalog_span(prompt: str) -> tuple[int, int]:
    """Locate Shelley's final unfenced skills catalog outside root guidance."""
    lines = prompt.splitlines(keepends=True)
    guidance_start = next((i for i, line in enumerate(lines) if line.strip() == "<guidance>"), None)
    guidance_end = max((i for i, line in enumerate(lines) if line.strip() == "</guidance>"), default=-1)
    if guidance_start is not None and guidance_end < guidance_start:
        raise ValueError("Unterminated Shelley guidance")
    start = end = None
    fence = ""
    offset = 0
    for i, raw in enumerate(lines):
        position, offset = offset, offset + len(raw)
        if guidance_start is not None and guidance_start <= i <= guidance_end:
            continue
        line = raw.strip()
        marker = re.match(r"(`{3,}|~{3,})", line)
        if marker:
            if not fence:
                fence = marker[0]
            elif marker[0][0] == fence[0] and len(marker[0]) >= len(fence) and not line[len(marker[0]):].strip():
                fence = ""
            continue
        if fence:
            continue
        if line == "<skills>":
            start, end = offset, None
        elif line == "</skills>" and start is not None and end is None:
            end = position
    if start is None or end is None:
        raise ValueError("Missing Shelley skills envelope")
    catalog = re.search(r"(?ms)^<available_skills>\n.*?^</available_skills>", prompt[start:end])
    if catalog is None:
        raise ValueError("Missing Shelley available_skills catalog")
    return start + catalog.start(), start + catalog.end()


def merge_prompt_catalog(prompt: str, entries: list[dict], home: Path) -> str:
    """Add qualified plugin entries to the catalog consumed by both model and picker."""
    if not entries:
        return prompt
    start, end = prompt_catalog_span(prompt)
    root = ET.fromstring(prompt[start:end])
    names = {skill.findtext("name") for skill in root}
    executable = str(home / ".local/bin/plugin-skills")
    for entry in entries:
        if entry["name"] in names:
            raise ValueError(f"Duplicate prompt skill: {entry['name']}")
        names.add(entry["name"])
        skill = ET.SubElement(root, "skill")
        for key in ("name", "description"):
            ET.SubElement(skill, key).text = entry[key]
        ET.SubElement(skill, "invocation").text = "explicit" if entry["explicit"] else "automatic"
        ET.SubElement(skill, "location").text = entry["path"]
        ET.SubElement(skill, "activate").text = shlex.join([executable, "cat", entry["name"]])
    ET.indent(root)
    instructions = (
        "\n\n# Installed plugin skills\n\n"
        "These skills are available in addition to Shelley's built-in skill list. "
        "Use the activation command to read a skill before following it. "
        "Automatic entries may be selected when their descriptions match the task; "
        "explicit entries require the user's request. "
        "Resolve relative resources from the skill's location, not the working directory. "
        "Other skills in the same plugin retain the same plugin:skill namespace. "
        "Plugin-specific agents and tools are not registered in Shelley; "
        "report unsupported steps rather than claiming they ran.\n"
    )
    return prompt[:start] + ET.tostring(root, encoding="unicode") + instructions + prompt[end:]


def transform_prompt(prompt: str, home: Path) -> str:
    """Keep Shelley usable if its optional plugin catalog is absent or broken."""
    try:
        return merge_prompt_catalog(prompt, load_catalog(home), home)
    except FileNotFoundError:
        pass
    except Exception as error:
        print(f"plugin-skills: catalog unavailable: {error}", file=sys.stderr)
    return prompt


def main() -> None:
    """List, read, refresh, or advertise the indexed plugin skills."""
    parser = argparse.ArgumentParser(description=__doc__)
    subcommands = parser.add_subparsers(dest="command", required=True)
    subcommands.add_parser("ls", help="list plugin-qualified skill names")
    read = subcommands.add_parser("cat", help="print the original SKILL.md unchanged")
    read.add_argument("name")
    subcommands.add_parser("refresh", help="refresh metadata from local Codex discovery")
    subcommands.add_parser("prompt", help="merge plugin metadata into Shelley's skill catalog")
    args = parser.parse_args()
    home = Path.home()
    if args.command == "prompt":
        sys.stdout.write(transform_prompt(sys.stdin.read(), home))
        return
    try:
        if args.command == "refresh":
            print(f"Indexed {refresh(home)} plugin skills for Shelley.")
        else:
            entries = load_catalog(home)
            if args.command == "ls":
                for entry in entries:
                    restriction = "[explicit] " if entry["explicit"] else ""
                    print(f"{entry['name']}\t{restriction}{entry['description']}")
            else:
                entry = next((item for item in entries if item["name"] == args.name), None)
                if entry is None:
                    raise ValueError(f"Plugin skill not found: {args.name}")
                sys.stdout.buffer.write(Path(entry["path"]).read_bytes())
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        parser.exit(1, f"plugin-skills: {error}\n")


if __name__ == "__main__":
    main()

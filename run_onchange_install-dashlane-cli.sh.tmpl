#!/usr/bin/env bash
set -euo pipefail

# Dashlane CLI (dcli) ships prebuilt single-file binaries on GitHub releases
# (no npm/brew dep, which the VMs don't manage). chezmoi resolves the latest
# release tag below at apply time; when a new release ships this file's
# content changes, so run_onchange re-runs and upgrades the binary in place.
tag="{{ (gitHubLatestRelease "Dashlane/dashlane-cli").TagName }}"
latest="${tag#v}"

if command -v dcli >/dev/null 2>&1; then
  current="$(dcli --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
  [ "$current" = "$latest" ] && exit 0
fi

# Dashlane only publishes a linux x64 binary (no arm64 linux).
case "$(uname -m)" in
  x86_64|amd64) asset="dcli-linux-x64" ;;
  *) echo "install-dashlane-cli: unsupported arch $(uname -m); skipping" >&2; exit 0 ;;
esac

mkdir -p "$HOME/.local/bin"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

curl -fsSL "https://github.com/Dashlane/dashlane-cli/releases/download/${tag}/${asset}" \
  -o "$tmp/dcli"
install -m 0755 "$tmp/dcli" "$HOME/.local/bin/dcli"

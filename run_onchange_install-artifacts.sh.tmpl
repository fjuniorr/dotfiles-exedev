#!/usr/bin/env bash
set -euo pipefail

if [ "$(uname -s)" != Linux ]; then
  echo "install-artifacts: only supported on Linux; skipping" >&2
  exit 0
fi

if [ ! -x /usr/bin/python3 ] || ! command -v systemctl >/dev/null ||
    ! command -v ss >/dev/null; then
  echo "install-artifacts: requires /usr/bin/python3, systemd, and ss" >&2
  exit 1
fi

if ! systemctl is-active --quiet artifacts.service &&
    [ -n "$(ss -H -ltn 'sport = :8765')" ]; then
  echo "install-artifacts: port 8765 is occupied; leaving its server untouched" >&2
  exit 1
fi

tmp="$(mktemp -d)"
trap 'rm -f "$tmp/server.py" "$tmp/artifacts.service"; rmdir "$tmp"' EXIT

# Embedding the sources makes run_onchange rerun when either source changes.
cat > "$tmp/server.py" <<'PYTHON'
{{ include ".chezmoitemplates/artifacts/server.py" }}
PYTHON
cat > "$tmp/artifacts.service" <<'UNIT'
{{ template "artifacts/service" . }}
UNIT

sudo install -D -m 0644 "$tmp/server.py" /usr/local/lib/artifacts/server.py
sudo install -m 0644 "$tmp/artifacts.service" /etc/systemd/system/artifacts.service
sudo systemctl daemon-reload
sudo systemctl enable artifacts.service
sudo systemctl restart artifacts.service
sudo systemctl is-active --quiet artifacts.service
echo "artifacts: serving /tmp/artifacts on port 8765 (8000 stays available for Django)"

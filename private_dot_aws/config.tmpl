{{/* SSO profile for ficks (see docs/aws-access.md in the ficks repo). On a
     browserless VM, log in with the device-code flow:
     `aws sso login --profile ficks --use-device-code` */ -}}
[profile ficks]
region = us-east-1
sso_session = ficks-sso
sso_account_id = {{ .ficksAwsAccountId }}
sso_role_name = AdministratorAccess
output = json

[sso-session ficks-sso]
sso_start_url = {{ .ficksSsoStartUrl }}
sso_region = us-east-1
sso_registration_scopes = sso:account:access

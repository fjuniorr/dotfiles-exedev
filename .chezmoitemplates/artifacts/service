[Unit]
Description=Shared temporary static files for agents
After=network.target

[Service]
Type=simple
User={{ .chezmoi.username }}
ExecStartPre=/usr/bin/mkdir -p /tmp/artifacts
ExecStart=/usr/bin/python3 -B /usr/local/lib/artifacts/server.py --port 8765 --directory /tmp/artifacts
Restart=always
RestartSec=2
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ReadWritePaths=/tmp
NoExecPaths=/tmp
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
